rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function supervisor() {
      return autenticado() && perfil().cargo == 'supervisor';
    }

    function equipe() {
      return autenticado() && (perfil().cargo == 'supervisor' || perfil().cargo == 'tecnico');
    }

    match /usuarios/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || supervisor());
      allow list: if supervisor();

      // O primeiro perfil só pode ser criado pelo próprio usuário como técnico.
      allow create: if autenticado()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['nome', 'email', 'cargo', 'criado_em'])
                    && request.resource.data.cargo == 'tecnico'
                    && request.resource.data.email == request.auth.token.email;
      allow update, delete: if supervisor();
    }

    match /demandas/{demandaId} {
      allow read: if equipe();
      allow create, delete: if supervisor();
      allow update: if supervisor() || (
        equipe()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'observacao_tecnico', 'concluido_em'])
        && request.resource.data.status in ['Em Andamento', 'Concluído', 'Cancelado']
      );
    }

    match /unidades/{unidadeId} {
      allow read: if equipe();
      allow write: if supervisor();
    }

    match /configuracoes/{configuracaoId} {
      allow read, write: if supervisor();
    }
  }
}
