rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Modelo de dados assumido
    // ===============================================================
    // usuarios/{uid}: nome, email, cargo, criado_em
    // demandas/{id}: protocolo, tipo_manutencao, unidade_atendida,
    //   quem_atendido, prioridade, descricao, status, observacao_tecnico,
    //   prazo_limite ou criado_em e, opcionalmente, concluido_em
    // unidades/{id}: nome, endereco, criado_em e, opcionalmente, id_unidade
    // emprestimos/{id}: produto, emprestado_para, numero_tombo,
    //   data_emprestimo, data_devolucao, status, criado_por e criado_em;
    //   quando devolvido, inclui devolvido_em e auditoria da devolução
    // configuracoes/{contador}: ultimo_numero
    // produtos_estoque/{id}: nome, codigo, quantidade, ativo, auditoria
    // consumos_os/{demandaId_produtoId}: material usado e vínculo com a OS
    // movimentacoes_estoque/{id}: histórico imutável de entradas administrativas

    // ===============================================================
    // Funções comuns
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner(data) {
      return isAuthenticated() &&
        (!('uid' in data) || data.uid == request.auth.uid);
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified(before, after) {
      return !('uid' in after) ||
        (('uid' in before) && after.uid == before.uid);
    }

    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function hasProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isSupervisor() {
      return hasProfile() && profile().data.cargo in ['supervisor', 'Supervisor', 'SUPERVISOR'];
    }

    function isOperational() {
      return hasProfile() &&
        profile().data.cargo is string &&
        profile().data.cargo.size() >= 1 &&
        profile().data.cargo.size() <= 40;
    }

    function validText(value, minSize, maxSize) {
      return value is string &&
        value.size() >= minSize && value.size() <= maxSize;
    }

    function validIsoDate(value) {
      return value is string && value.size() >= 20 && value.size() <= 40 &&
        value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*$');
    }

    function validOptionalIsoDate(data, field) {
      return !(field in data) || validIsoDate(data[field]);
    }

    function validOptionalDemandDate(data, field) {
      return !(field in data) || validIsoDate(data[field]) ||
        (data[field] is string && data[field].size() >= 16 &&
         data[field].size() <= 100 && data[field].matches('^Solicitado em:.*$'));
    }

    function validOptionalText(data, field, maxSize) {
      return !(field in data) || validText(data[field], 0, maxSize);
    }

    function validDateOnly(value) {
      return value is string && value.size() == 10 &&
        value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validStatusActor(actor) {
      return actor is map &&
        actor.keys().hasAll(['uid', 'nome', 'cargo']) &&
        actor.keys().hasOnly(['uid', 'nome', 'cargo']) &&
        validText(actor.uid, 1, 128) &&
        validText(actor.nome, 1, 120) &&
        validText(actor.cargo, 1, 40);
    }

    function validOptionalStatusAudit(data) {
      return (!('status_alterado_por' in data) && !('status_alterado_em' in data)) ||
        (('status_alterado_por' in data) && ('status_alterado_em' in data) &&
         validStatusActor(data.status_alterado_por) &&
         data.status_alterado_em is timestamp);
    }

    // ===============================================================
    // Validadores de domínio, usados em create e update
    // ===============================================================
    function isValidUser(data) {
      return data.keys().hasAll(['nome', 'email', 'cargo', 'criado_em']) &&
        data.keys().hasOnly(['nome', 'email', 'cargo', 'criado_em']) &&
        validText(data.nome, 1, 120) &&
        validText(data.email, 3, 254) &&
        data.email.matches('^[^@]+@[^@]+[.][^@]+$') &&
        data.cargo in ['supervisor', 'tecnico', 'ti', 'pendente'] &&
        validIsoDate(data.criado_em);
    }

    function isValidDemanda(data) {
      return data.keys().hasAll([
          'protocolo', 'tipo_manutencao', 'unidade_atendida',
          'quem_atendido', 'prioridade', 'descricao', 'status',
          'observacao_tecnico'
        ]) &&
        data.keys().hasOnly([
          'protocolo', 'tipo_manutencao', 'unidade_atendida',
          'quem_atendido', 'prioridade', 'descricao', 'status',
          'observacao_tecnico', 'prazo_limite', 'criado_em', 'concluido_em',
          'status_alterado_por', 'status_alterado_em'
        ]) &&
        ('prazo_limite' in data || 'criado_em' in data) &&
        data.protocolo is int && data.protocolo >= 1000 && data.protocolo <= 999999999 &&
        data.tipo_manutencao in [
          'Elétrica', 'Hidráulica', 'Patrimônio', 'Capina', 'Limpeza', "Limpeza de Caixa d'água",
          'Marcenaria', 'Alvenaria', 'Cobertura (Telhados)', 'Serralheria',
          'Montagem de Mobiliário e Equipamentos', 'Geral', 'Outros', 'TI'
        ] &&
        validText(data.unidade_atendida, 1, 200) &&
        validText(data.quem_atendido, 0, 200) &&
        data.prioridade in ['Normal', 'Alta', 'Crítico'] &&
        validText(data.descricao, 0, 3000) &&
        data.status in ['Pendente', 'Em Andamento', 'Concluído', 'Cancelado'] &&
        validText(data.observacao_tecnico, 0, 5000) &&
        validOptionalDemandDate(data, 'prazo_limite') &&
        validOptionalIsoDate(data, 'criado_em') &&
        validOptionalIsoDate(data, 'concluido_em') &&
        validOptionalStatusAudit(data);
    }

    function isValidUnidade(data) {
      return data.keys().hasAll(['nome', 'endereco', 'criado_em']) &&
        data.keys().hasOnly(['nome', 'endereco', 'criado_em', 'id_unidade']) &&
        validText(data.nome, 1, 200) &&
        validText(data.endereco, 1, 500) &&
        validIsoDate(data.criado_em) &&
        validOptionalText(data, 'id_unidade', 30);
    }

    function isValidEmprestimo(data) {
      return data.keys().hasAll([
          'produto', 'emprestado_para', 'numero_tombo',
          'data_emprestimo', 'data_devolucao', 'status', 'criado_por', 'criado_em'
        ]) &&
        data.keys().hasOnly([
          'produto', 'emprestado_para', 'numero_tombo',
          'data_emprestimo', 'data_devolucao', 'status', 'criado_por', 'criado_em',
          'devolvido_em', 'estado_devolucao',
          'devolucao_registrada_por', 'devolucao_registrada_em'
        ]) &&
        validText(data.produto, 1, 200) &&
        validText(data.emprestado_para, 1, 200) &&
        validText(data.numero_tombo, 1, 80) &&
        validDateOnly(data.data_emprestimo) &&
        validDateOnly(data.data_devolucao) &&
        data.data_devolucao >= data.data_emprestimo &&
        data.status in ['Em uso', 'Devolvido'] &&
        validStatusActor(data.criado_por) &&
        data.criado_em is timestamp &&
        ((data.status == 'Em uso' &&
          !('devolvido_em' in data) &&
          !('estado_devolucao' in data) &&
          !('devolucao_registrada_por' in data) &&
          !('devolucao_registrada_em' in data)) ||
         (data.status == 'Devolvido' &&
          validDateOnly(data.devolvido_em) &&
          data.devolvido_em >= data.data_emprestimo &&
          data.estado_devolucao in ['Bom estado', 'Com avarias', 'Danificado'] &&
          validStatusActor(data.devolucao_registrada_por) &&
          data.devolucao_registrada_em is timestamp));
    }

    function loanActorMatchesRequester(data) {
      return validStatusActor(data.criado_por) &&
        data.criado_por.uid == request.auth.uid &&
        data.criado_por.nome == profile().data.nome &&
        data.criado_por.cargo == profile().data.cargo &&
        data.criado_em == request.time;
    }

    function returnActorMatchesRequester(data) {
      return data.status == 'Devolvido' &&
        validStatusActor(data.devolucao_registrada_por) &&
        data.devolucao_registrada_por.uid == request.auth.uid &&
        data.devolucao_registrada_por.nome == profile().data.nome &&
        data.devolucao_registrada_por.cargo == profile().data.cargo &&
        data.devolucao_registrada_em == request.time;
    }

    function isValidCounter(data) {
      return data.keys().hasAll(['ultimo_numero']) &&
        data.keys().hasOnly(['ultimo_numero']) &&
        data.ultimo_numero is int &&
        data.ultimo_numero >= 0 && data.ultimo_numero <= 999999999;
    }

    function isValidProdutoEstoque(data) {
      return data.keys().hasAll([
          'nome', 'codigo', 'quantidade', 'ativo', 'criado_por',
          'criado_em', 'atualizado_em'
        ]) &&
        data.keys().hasOnly([
          'nome', 'codigo', 'quantidade', 'ativo', 'criado_por',
          'criado_em', 'atualizado_em', 'ultima_operacao_id'
        ]) &&
        validText(data.nome, 1, 150) &&
        validText(data.codigo, 1, 80) &&
        data.quantidade is int && data.quantidade >= 0 && data.quantidade <= 1000000 &&
        data.ativo is bool &&
        validStatusActor(data.criado_por) &&
        data.criado_em is timestamp && data.atualizado_em is timestamp &&
        validOptionalText(data, 'ultima_operacao_id', 300);
    }

    function isValidConsumoOs(data) {
      return data.keys().hasAll([
          'demanda_id', 'protocolo', 'produto_id', 'produto_nome',
          'quantidade', 'responsavel', 'criado_em'
        ]) &&
        data.keys().hasOnly([
          'demanda_id', 'protocolo', 'produto_id', 'produto_nome',
          'quantidade', 'responsavel', 'criado_em'
        ]) &&
        validText(data.demanda_id, 1, 128) &&
        data.protocolo is int && data.protocolo >= 1000 && data.protocolo <= 999999999 &&
        validText(data.produto_id, 1, 128) &&
        validText(data.produto_nome, 1, 150) &&
        data.quantidade is int && data.quantidade > 0 && data.quantidade <= 1000000 &&
        validStatusActor(data.responsavel) &&
        data.criado_em is timestamp;
    }

    function consumoActorMatchesRequester(data) {
      return data.responsavel.uid == request.auth.uid &&
        data.responsavel.nome == profile().data.nome &&
        data.responsavel.cargo == profile().data.cargo &&
        data.criado_em == request.time;
    }

    function isValidMovimentacaoEstoque(data) {
      return data.keys().hasAll([
          'tipo', 'produto_id', 'produto_nome', 'quantidade',
          'responsavel', 'detalhes', 'criado_em'
        ]) &&
        data.keys().hasOnly([
          'tipo', 'produto_id', 'produto_nome', 'quantidade',
          'responsavel', 'detalhes', 'criado_em'
        ]) &&
        data.tipo in ['entrada', 'saida'] &&
        validText(data.produto_id, 1, 128) &&
        validText(data.produto_nome, 1, 150) &&
        data.quantidade is int && data.quantidade >= 0 && data.quantidade <= 1000000 &&
        validStatusActor(data.responsavel) &&
        validText(data.detalhes, 1, 500) &&
        data.criado_em is timestamp;
    }

    function canReadDemanda() {
      return isOperational();
    }

    function canOperationalUpdateDemanda() {
      return isOperational() &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'prioridade', 'tipo_manutencao', 'unidade_atendida',
            'observacao_tecnico', 'concluido_em',
            'status_alterado_por', 'status_alterado_em'
          ]) ||
          (isSupervisor() &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'prioridade', 'tipo_manutencao', 'unidade_atendida',
             'descricao', 'observacao_tecnico', 'concluido_em',
             'status_alterado_por', 'status_alterado_em'
           ]))
        ) &&
        request.resource.data.status in [
          'Pendente', 'Em Andamento', 'Concluído', 'Cancelado'
        ] &&
        (!(request.resource.data.status in ['Concluído', 'Cancelado']) ||
          (validText(request.resource.data.observacao_tecnico, 1, 5000) &&
           'concluido_em' in request.resource.data));
    }

    function statusAuditMatchesRequester(data) {
      return ('status_alterado_por' in data) &&
        ('status_alterado_em' in data) &&
        validStatusActor(data.status_alterado_por) &&
        data.status_alterado_em is timestamp &&
        data.status_alterado_em == request.time &&
        data.status_alterado_por.uid == request.auth.uid &&
        data.status_alterado_por.nome == profile().data.nome &&
        data.status_alterado_por.cargo == profile().data.cargo;
    }

    function isValidCounterCreate(configId, data) {
      return isValidCounter(data) &&
        ((configId == 'contador_protocolo' && data.ultimo_numero == 1000) ||
         (configId == 'contador_unidades' && data.ultimo_numero == 100));
    }

    function isValidCounterUpdate(data) {
      return isValidCounter(data) &&
        data.ultimo_numero == resource.data.ultimo_numero + 1;
    }

    match /usuarios/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidUser(request.resource.data) &&
        isDocOwner(request.resource.data) &&
        uidUnchanged() &&
        request.resource.data.cargo == 'tecnico' &&
        request.resource.data.email == request.auth.token.email;
      allow update: if false;
      allow delete: if false;
    }

    match /demandas/{demandaId} {
      allow read: if canReadDemanda();
      allow create: if isOperational() &&
        isValidDemanda(request.resource.data) &&
        statusAuditMatchesRequester(request.resource.data) &&
        getAfter(/databases/$(database)/documents/configuracoes/contador_protocolo)
          .data.ultimo_numero == request.resource.data.protocolo;
      allow update: if isValidDemanda(request.resource.data) &&
        uidNotModified(resource.data, request.resource.data) &&
        statusAuditMatchesRequester(request.resource.data) &&
        canOperationalUpdateDemanda();
      allow delete: if isOperational();
    }

    match /unidades/{unidadeId} {
      allow read: if isOperational();
      allow create: if isSupervisor() && isValidUnidade(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    match /emprestimos/{emprestimoId} {
      allow read: if isOperational();
      allow create: if isOperational() &&
        isValidEmprestimo(request.resource.data) &&
        loanActorMatchesRequester(request.resource.data);
      allow update: if isOperational() &&
        isValidEmprestimo(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'devolvido_em', 'estado_devolucao',
          'devolucao_registrada_por', 'devolucao_registrada_em'
        ]) &&
        (!('status' in resource.data) || resource.data.status == 'Em uso') &&
        returnActorMatchesRequester(request.resource.data);
      allow delete: if false;
    }

    match /produtos_estoque/{produtoId} {
      allow read: if isOperational();
      allow create: if isSupervisor() &&
        isValidProdutoEstoque(request.resource.data) &&
        request.resource.data.codigo == produtoId &&
        request.resource.data.criado_por.uid == request.auth.uid &&
        request.resource.data.criado_por.nome == profile().data.nome &&
        request.resource.data.criado_por.cargo == profile().data.cargo &&
        request.resource.data.criado_em == request.time &&
        request.resource.data.atualizado_em == request.time;
      allow update: if isValidProdutoEstoque(request.resource.data) &&
        request.resource.data.codigo == resource.data.codigo &&
        request.resource.data.criado_por == resource.data.criado_por &&
        request.resource.data.criado_em == resource.data.criado_em &&
        (
          isSupervisor() ||
          (isOperational() &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'quantidade', 'ultima_operacao_id', 'atualizado_em'
           ]) &&
           request.resource.data.atualizado_em == request.time &&
           ('ultima_operacao_id' in request.resource.data) &&
           (
             (existsAfter(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)) &&
              getAfter(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)).data.produto_id == produtoId &&
              ((!exists(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)) &&
                request.resource.data.quantidade == resource.data.quantidade -
                  getAfter(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)).data.quantidade) ||
               (exists(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)) &&
                getAfter(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)).data.quantidade >
                  get(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)).data.quantidade &&
                request.resource.data.quantidade == resource.data.quantidade -
                  (getAfter(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)).data.quantidade -
                   get(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)).data.quantidade)))) ||
             (!existsAfter(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)) &&
              exists(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)) &&
              get(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)).data.produto_id == produtoId &&
              request.resource.data.quantidade == resource.data.quantidade +
                get(/databases/$(database)/documents/consumos_os/$(request.resource.data.ultima_operacao_id)).data.quantidade)
           ))
        );
      allow delete: if false;
    }

    match /consumos_os/{consumoId} {
      allow read: if isOperational();
      allow create: if isOperational() && isValidConsumoOs(request.resource.data) &&
        consumoActorMatchesRequester(request.resource.data) &&
        exists(/databases/$(database)/documents/demandas/$(request.resource.data.demanda_id)) &&
        get(/databases/$(database)/documents/demandas/$(request.resource.data.demanda_id)).data.protocolo == request.resource.data.protocolo &&
        get(/databases/$(database)/documents/produtos_estoque/$(request.resource.data.produto_id)).data.ativo == true &&
        request.resource.data.produto_nome == get(/databases/$(database)/documents/produtos_estoque/$(request.resource.data.produto_id)).data.nome &&
        getAfter(/databases/$(database)/documents/produtos_estoque/$(request.resource.data.produto_id)).data.quantidade ==
          get(/databases/$(database)/documents/produtos_estoque/$(request.resource.data.produto_id)).data.quantidade - request.resource.data.quantidade &&
        getAfter(/databases/$(database)/documents/produtos_estoque/$(request.resource.data.produto_id)).data.ultima_operacao_id == consumoId;
      allow update: if isOperational() && isValidConsumoOs(request.resource.data) &&
        consumoActorMatchesRequester(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantidade', 'responsavel', 'criado_em'
        ]) && request.resource.data.quantidade > resource.data.quantidade &&
        getAfter(/databases/$(database)/documents/produtos_estoque/$(resource.data.produto_id)).data.quantidade ==
          get(/databases/$(database)/documents/produtos_estoque/$(resource.data.produto_id)).data.quantidade -
            (request.resource.data.quantidade - resource.data.quantidade) &&
        getAfter(/databases/$(database)/documents/produtos_estoque/$(resource.data.produto_id)).data.ultima_operacao_id == consumoId;
      allow delete: if isOperational() &&
        getAfter(/databases/$(database)/documents/produtos_estoque/$(resource.data.produto_id)).data.quantidade ==
          get(/databases/$(database)/documents/produtos_estoque/$(resource.data.produto_id)).data.quantidade + resource.data.quantidade &&
        getAfter(/databases/$(database)/documents/produtos_estoque/$(resource.data.produto_id)).data.ultima_operacao_id == consumoId;
    }

    match /movimentacoes_estoque/{movimentoId} {
      allow read: if isSupervisor();
      allow create: if isSupervisor() &&
        isValidMovimentacaoEstoque(request.resource.data) &&
        request.resource.data.responsavel.uid == request.auth.uid &&
        request.resource.data.responsavel.nome == profile().data.nome &&
        request.resource.data.responsavel.cargo == profile().data.cargo &&
        request.resource.data.criado_em == request.time &&
        existsAfter(/databases/$(database)/documents/produtos_estoque/$(request.resource.data.produto_id)) &&
        request.resource.data.produto_nome ==
          getAfter(/databases/$(database)/documents/produtos_estoque/$(request.resource.data.produto_id)).data.nome;
      allow update, delete: if false;
    }

    match /configuracoes/{configId} {
      allow read: if isOperational() &&
        configId in ['contador_protocolo', 'contador_unidades'];
      allow create: if isOperational() &&
        configId in ['contador_protocolo', 'contador_unidades'] &&
        isValidCounterCreate(configId, request.resource.data);
      allow update: if isOperational() &&
        configId in ['contador_protocolo', 'contador_unidades'] &&
        isValidCounterUpdate(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
